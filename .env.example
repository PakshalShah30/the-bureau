# Required for production. DEMO_MODE=true enables a local, clearly labeled preview without PostgreSQL.
DATABASE_URL="postgresql://postgres:password@localhost:5432/the_bureau?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
CRON_SECRET="replace-with-a-different-random-secret"
# Your host's max function duration in seconds (Vercel: Project → Settings → Functions). Refreshes stop
# starting new work before this limit; leftovers continue on the next run. Default 300.
FUNCTION_MAX_SECONDS=""
# Optional overrides for the scheduled refresh: seconds of work per call (default 75% of the limit)
# and users refreshed in parallel (default 3).
CRON_BUDGET_SECONDS=""
CRON_CONCURRENCY=""
# OpenAI-compatible chat completions API; never exposed to the browser.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
# Optional defaults; user-specific keys can be added in Settings (encrypted at rest).
HUMANIZER_API_KEY=""
HUMANIZER_API_URL=""
DETECTOR_API_KEY=""
DETECTOR_API_URL=""
# For the local offline preview only; never enable on a public production deployment.
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"
# Optional override if YC rotates its publicly embedded read-only search key.
YC_ALGOLIA_SEARCH_KEY=""
